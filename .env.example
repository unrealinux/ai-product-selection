# 复制为 .env 后按需修改；不配置 LLM 时系统自动退化为纯规则打分。

# ---- 数据库 ----
APS_DB_PATH=data/products.db

# ---- LLM（任何 OpenAI 兼容接口皆可：OpenAI / DeepSeek / 通义 / 本地 vLLM 等）----
APS_LLM_ENABLED=false
APS_LLM_BASE_URL=https://api.deepseek.com/v1
APS_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
APS_LLM_MODEL=deepseek-chat
APS_LLM_TIMEOUT=60

# ---- 抖音开放平台（抖店 / 精选联盟）----
# 申请入口：https://op.jinritemai.com/
# 文档：API 调用指南 https://op.jinritemai.com/docs/guide-docs/148/814
APS_DOUYIN_APP_KEY=
APS_DOUYIN_APP_SECRET=
# 自用型应用填 shop_id 后执行 scripts/douyin_fetch.py --token 换取
APS_DOUYIN_SHOP_ID=
APS_DOUYIN_ACCESS_TOKEN=
APS_DOUYIN_SIGN_METHOD=hmac-sha256
APS_DOUYIN_BASE_URL=https://openapi-fxg.jinritemai.com
APS_DOUYIN_TIMEOUT=30

# ---- 服务端口 ----
APS_API_HOST=127.0.0.1
APS_API_PORT=8000
