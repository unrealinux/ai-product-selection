# 复制为 .env 后按需修改；不配置 LLM 时系统自动退化为纯规则打分。

# ---- 数据库 ----
APS_DB_PATH=data/products.db

# ---- LLM（任何 OpenAI 兼容接口皆可：OpenAI / DeepSeek / 通义 / 本地 vLLM 等）----
APS_LLM_ENABLED=false
APS_LLM_BASE_URL=https://api.deepseek.com/v1
APS_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
APS_LLM_MODEL=deepseek-chat
APS_LLM_TIMEOUT=60

# ---- 抖音开放平台（抖店 / 精选联盟）----
# 申请入口：https://op.jinritemai.com/
# 文档：API 调用指南 https://op.jinritemai.com/docs/guide-docs/148/814
APS_DOUYIN_APP_KEY=
APS_DOUYIN_APP_SECRET=
# 自用型应用填 shop_id 后执行 scripts/douyin_fetch.py --token 换取
APS_DOUYIN_SHOP_ID=
APS_DOUYIN_ACCESS_TOKEN=
APS_DOUYIN_SIGN_METHOD=hmac-sha256
APS_DOUYIN_BASE_URL=https://openapi-fxg.jinritemai.com
APS_DOUYIN_TIMEOUT=30

# ---- 维度补齐（接口未提供的重量 / 复购 / 合规）----
# 走大模型估算，需上面的 LLM 配置可用；估算结果缓存在下方文件里
APS_ENRICH_BATCH_SIZE=8
# 商品详情接口最多尝试多少个商品（仅对自己店铺的商品有效），0=不启用
APS_ENRICH_DETAIL_LIMIT=0
APS_ENRICH_CACHE=data/cache/llm_estimates.json

# ---- 淘宝 A2A（官方公开的 Agent2Agent 接口）----
# agent card: https://pc-taoclaw.taobao.com/a2a/itemSearch/.well-known/agent.json
# 注意：这是内测中的能力，接口可能变动，调用频率要克制
APS_TAOBAO_A2A_URL=https://pc-taoclaw.taobao.com/a2a/itemSearch
APS_TAOBAO_TIMEOUT=45
APS_TAOBAO_INTERVAL=0.8
APS_TAOBAO_DETAIL_BATCH=10
APS_TAOBAO_RETRIES=2

# ---- 服务端口 ----
APS_API_HOST=127.0.0.1
APS_API_PORT=8000
